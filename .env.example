# ============================================================
#  Cloudflare
# ============================================================
# API トークン: テンプレート「Edit Cloudflare Workers」で作成し、
# Zone Resources に CUSTOM_DOMAIN のゾーンを含めること
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Worker 名（任意）
WORKER_NAME=oci-cdn-proxy

# 公開するホスト名。Cloudflare に登録済みゾーンのサブドメインで、
# DNS レコードがまだ無いもの（Worker のカスタムドメインとして自動作成される）
# カンマ区切りで複数指定可
CUSTOM_DOMAIN=cdn.example.com

# ============================================================
#  OCI オリジン（A〜C のどれか一つ）
# ============================================================

# --- A. 事前認証済リクエスト（推奨） ---
# プライベート・バケットに「バケット単位 / オブジェクトの読取りを許可 /
# オブジェクト・リストは無効」の PAR を作り、その URL を貼る。有効期限に注意。
OCI_PAR_URL=https://objectstorage.ap-tokyo-1.oraclecloud.com/p/XXXXXXXX/n/mynamespace/b/mybucket/o/

# --- B. S3 互換 API（顧客秘密キー） ---
# OCI_ACCESS_KEY_ID=
# OCI_SECRET_ACCESS_KEY=
# OCI_REGION=ap-tokyo-1
# OCI_NAMESPACE=mynamespace
# OCI_BUCKET=mybucket

# --- C. パブリック・バケット（オリジン直叩きで枠を消費されるので非推奨） ---
# OCI_REGION=ap-tokyo-1
# OCI_NAMESPACE=mynamespace
# OCI_BUCKET=mybucket

# ============================================================
#  オプション（コメントのままなら既定値）
# ============================================================
# オブジェクト名の先頭に付けるプレフィックス（例: public/ → /a.png は public/a.png を参照）
# PATH_PREFIX=
# 末尾が / のパスで返すオブジェクト名（例: index.html）。未設定なら 404
# INDEX_DOCUMENT=
# キャッシュ期間は秒数、または単位付き（s=秒 m=分 h=時間 d=日 w=週、例: 30d, 5m, 1h30m）
# エッジ（Cloudflare）でオブジェクトをキャッシュする期間（既定 30d）
EDGE_CACHE_TTL=30d
# 404 をエッジにキャッシュする期間（既定 5m、0 で無効）
NEGATIVE_CACHE_TTL=5m
# ブラウザに返す Cache-Control: max-age（既定 1h）
# BROWSER_CACHE_TTL=1h
# これより大きいオブジェクトはキャッシュせず素通し（MB、既定 512）
# MAX_CACHE_SIZE_MB=512
# true にするとクエリ文字列もキャッシュキーに含める（既定 false）
# CACHE_KEY_INCLUDE_QUERY=false
# CORS 許可オリジン。* またはカンマ区切りのオリジン一覧
# CORS_ALLOW_ORIGIN=
# CUSTOM_DOMAIN を設定していても workers.dev を有効にする
# ENABLE_WORKERS_DEV=false
